{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WebFluent",
  "scopeName": "source.webfluent",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#regex"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#theme-block"
    },
    {
      "include": "#animation-block"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#routing"
    },
    {
      "include": "#state-keywords"
    },
    {
      "include": "#control-flow"
    },
    {
      "include": "#style-block"
    },
    {
      "include": "#style-block-indented"
    },
    {
      "include": "#style-animation-keywords"
    },
    {
      "include": "#fetch-block"
    },
    {
      "include": "#fetch-callbacks"
    },
    {
      "include": "#boolean-null"
    },
    {
      "include": "#types"
    },
    {
      "include": "#events"
    },
    {
      "include": "#sub-components"
    },
    {
      "include": "#built-in-components"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#named-args"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.webfluent",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.webfluent",
          "match": "(//)\\s*(wf-allow)(\\()([^)]*)(\\))(.*)$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.webfluent"
            },
            "2": {
              "name": "keyword.other.directive.allow.webfluent"
            },
            "3": {
              "name": "punctuation.definition.arguments.begin.webfluent"
            },
            "4": {
              "name": "constant.other.diagnostic-code.webfluent"
            },
            "5": {
              "name": "punctuation.definition.arguments.end.webfluent"
            }
          }
        },
        {
          "name": "comment.line.double-slash.webfluent",
          "match": "//.*$"
        },
        {
          "name": "comment.block.webfluent",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.webfluent"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.webfluent",
          "begin": "(#+)\"",
          "end": "\"\\1",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.webfluent"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.webfluent"
            }
          }
        },
        {
          "name": "string.quoted.triple.webfluent",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.webfluent"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.webfluent"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.webfluent",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.webfluent",
              "begin": "\\{(?=[\\p{XID_Start}_\\[(])",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.webfluent"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.webfluent"
                }
              },
              "contentName": "meta.embedded.expression.webfluent",
              "patterns": [
                {
                  "include": "#format-spec"
                },
                {
                  "include": "#strings"
                },
                {
                  "include": "#operators"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#boolean-null"
                },
                {
                  "include": "#function-calls"
                },
                {
                  "name": "variable.other.readwrite.webfluent",
                  "match": "[\\p{XID_Start}_][\\p{XID_Continue}.]*"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.webfluent",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.webfluent"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.webfluent"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.webfluent",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.webfluent",
              "begin": "\\{(?=[\\p{XID_Start}_\\[(])",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.webfluent"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.webfluent"
                }
              },
              "contentName": "meta.embedded.expression.webfluent",
              "patterns": [
                {
                  "include": "#format-spec"
                },
                {
                  "include": "#strings"
                },
                {
                  "include": "#operators"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#boolean-null"
                },
                {
                  "include": "#function-calls"
                },
                {
                  "name": "variable.other.readwrite.webfluent",
                  "match": "[\\p{XID_Start}_][\\p{XID_Continue}.]*"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.other.date.webfluent",
          "match": "@[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}(?::[0-9]{2}(?:\\.[0-9]+)?)?(?:Z|[+-][0-9]{2}:[0-9]{2})?)?"
        },
        {
          "name": "constant.other.time.webfluent",
          "match": "@[0-9]{2}:[0-9]{2}(?::[0-9]{2}(?:\\.[0-9]+)?)?\\b"
        },
        {
          "name": "constant.numeric.money.webfluent",
          "match": "[$€£¥][0-9]+(?:\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.duration.webfluent",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\.(?:ms|seconds?|minutes?|hours?|days?|weeks?)\\b"
        },
        {
          "name": "constant.other.color.webfluent",
          "match": "#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})\\b"
        },
        {
          "name": "constant.numeric.float.webfluent",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.webfluent",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(page|component|store|theme|type|enum|api|animation|part)\\b\\s+(\\p{Lu}\\p{XID_Continue}*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.webfluent"
            },
            "2": {
              "name": "entity.name.type.webfluent"
            }
          }
        },
        {
          "match": "\\b(app)\\b(?=\\s*(?:\\{|$))",
          "name": "keyword.declaration.webfluent"
        },
        {
          "match": "(?<!\\.)\\b(const|image|data|socket|stream|channel|peer|worker|persist|validate)\\b\\s+([\\p{XID_Start}_]\\p{XID_Continue}*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.webfluent"
            },
            "2": {
              "name": "variable.other.declaration.webfluent"
            }
          }
        },
        {
          "name": "keyword.declaration.test.webfluent",
          "match": "\\b(test)\\b(?=\\s*\")"
        },
        {
          "name": "keyword.declaration.webfluent",
          "match": "\\b(from)\\b(?=\\s*\")"
        },
        {
          "match": "^\\s*(fn|prop)\\b(?=\\s+[\\p{XID_Start}_])",
          "captures": {
            "1": {
              "name": "keyword.declaration.webfluent"
            }
          }
        },
        {
          "match": "^\\s*(integrity)\\b(?=\\s*:)",
          "captures": {
            "1": {
              "name": "keyword.declaration.webfluent"
            }
          }
        },
        {
          "name": "keyword.declaration.webfluent",
          "match": "\\b(headers|errors)\\b(?=\\s*(?:\\{|$))"
        },
        {
          "name": "keyword.declaration.webfluent",
          "match": "\\b(at)\\b(?=\\s*\")"
        },
        {
          "match": "^\\s*(get|post|put|patch|delete|head|options)\\s+([\\p{XID_Start}_]\\p{XID_Continue}*)(?=\\s*[(\\s-]|$)",
          "captures": {
            "1": {
              "name": "keyword.declaration.webfluent"
            },
            "2": {
              "name": "entity.name.function.webfluent"
            }
          }
        },
        {
          "match": "^\\s*(send|receive)\\s+(\\p{Lu}\\p{XID_Continue}*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.webfluent"
            },
            "2": {
              "name": "entity.name.type.webfluent"
            }
          }
        }
      ]
    },
    "routing": {
      "patterns": [
        {
          "name": "keyword.control.routing.webfluent",
          "match": "\\b(Router|Route)\\b"
        }
      ]
    },
    "state-keywords": {
      "patterns": [
        {
          "match": "(?<!\\.)\\b(state|derived|resource|let)\\b\\s+([\\p{XID_Start}_]\\p{XID_Continue}*)",
          "captures": {
            "1": {
              "name": "keyword.other.state.webfluent"
            },
            "2": {
              "name": "variable.other.state.webfluent"
            }
          }
        },
        {
          "match": "(?<!\\.)\\b(action|event)\\b\\s+([\\p{XID_Start}_]\\p{XID_Continue}*)",
          "captures": {
            "1": {
              "name": "keyword.other.action.webfluent"
            },
            "2": {
              "name": "entity.name.function.action.webfluent"
            }
          }
        },
        {
          "match": "(?<!\\.)\\b(emit)\\b\\s+([\\p{XID_Start}_]\\p{XID_Continue}*)",
          "captures": {
            "1": {
              "name": "keyword.other.emit.webfluent"
            },
            "2": {
              "name": "entity.name.function.event.webfluent"
            }
          }
        },
        {
          "match": "(?<!\\.)\\b(slot)\\b(\\s+((?!\\p{Lu})[\\p{XID_Start}_]\\p{XID_Continue}*))?",
          "captures": {
            "1": {
              "name": "keyword.other.slot.webfluent"
            },
            "3": {
              "name": "entity.name.tag.slot.webfluent"
            }
          }
        },
        {
          "name": "keyword.other.webfluent",
          "match": "(?<!\\.)\\b(use|effect|return|children|await|navigate|log)\\b"
        },
        {
          "name": "keyword.other.webfluent",
          "match": "(?<!\\.)\\b(every|after)\\b(?=\\s*\\()"
        },
        {
          "name": "keyword.other.webfluent",
          "match": "(?<!\\.)\\b(cleanup|head|sequence)\\b(?=\\s*(?:\\{|$))"
        },
        {
          "name": "keyword.other.webfluent",
          "match": "(?<!\\.)\\b(step)\\b(?=\\s*(?:[({]|$))"
        },
        {
          "name": "keyword.other.webfluent",
          "match": "(?<!\\.)\\b(concurrent)\\b(?=\\s*(?:\\{|$))"
        },
        {
          "name": "keyword.other.webfluent",
          "match": "(?<!\\.)\\b(debounce|throttle)\\b(?=\\s*:)"
        },
        {
          "name": "keyword.other.webfluent",
          "match": "(?<!\\.)\\b(migrate)\\b(?=\\s+[0-9])"
        },
        {
          "match": "(?<!\\.)\\b(expect)\\b(?:\\s+(not)\\b)?(?=\\s*\")",
          "captures": {
            "1": {
              "name": "keyword.other.test.webfluent"
            },
            "2": {
              "name": "keyword.other.test.webfluent"
            }
          }
        },
        {
          "name": "keyword.other.test.webfluent",
          "match": "(?<!\\.)\\b(click|press|type|into)\\b(?=\\s+\")"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.webfluent",
          "match": "(?<!\\.)\\b(if|else|for|in|by|show|match|let|try|catch)\\b(?!\\s*:)"
        }
      ]
    },
    "style-block": {
      "begin": "\\b(style|transition)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.style.webfluent"
        }
      },
      "end": "\\}",
      "name": "meta.style-block.webfluent",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "meta.nested-rule.webfluent",
          "begin": "^([ \\t]*)([&@.:\\[>*+~][^{\\n]*?)[ \\t]*(?=$|//)",
          "beginCaptures": {
            "2": {
              "name": "entity.name.tag.selector.webfluent"
            }
          },
          "end": "^(?!\\1[ \\t])(?=[ \\t]*\\S)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#style-declaration"
            }
          ]
        },
        {
          "begin": "(?:^|(?<=[{;])|(?<=\\s\\s))\\s*([&@.:\\[>*+~][^{\\n]*)\\{",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag.selector.webfluent"
            }
          },
          "end": "\\}",
          "name": "meta.nested-rule.webfluent",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#style-declaration"
            }
          ]
        },
        {
          "include": "#style-declaration"
        }
      ]
    },
    "style-animation-keywords": {
      "patterns": [
        {
          "name": "keyword.other.style.webfluent",
          "match": "\\b(style|transition)\\b(?=\\s*\\{)"
        }
      ]
    },
    "fetch-block": {
      "patterns": []
    },
    "fetch-callbacks": {
      "patterns": [
        {
          "name": "keyword.control.match-arm.webfluent",
          "match": "(?<!\\.)\\b(loading|error|ready)\\b(?=\\s*[\\({]|\\s*$)"
        },
        {
          "name": "keyword.control.match-arm.webfluent",
          "match": "(?<!\\.)\\b(connecting|open)\\b(?=\\s*(?:\\{|$))|(?<!\\.)\\b(closed)\\b(?=\\s*(?:[({]|$))"
        }
      ]
    },
    "boolean-null": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.webfluent",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.webfluent",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.null.webfluent",
          "match": "\\bnull\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.webfluent",
          "match": "\\b(String|Number|Bool|Map|Any|Date|Time|DateTime|Duration|Money|Url|Email|Color|Uuid|File|Secret)\\b"
        }
      ]
    },
    "events": {
      "patterns": [
        {
          "match": "(?<!\\.)\\b(on)\\s+((?!\\p{Lu})[\\p{XID_Start}_]\\p{XID_Continue}*)(?=\\s*(?:[\\({]|$))",
          "captures": {
            "1": {
              "name": "keyword.other.event.webfluent"
            },
            "2": {
              "name": "entity.name.event.webfluent"
            }
          }
        }
      ]
    },
    "sub-components": {
      "patterns": [
        {
          "match": "\\b(Card|Navbar|Sidebar|Menu|Dropdown|Breadcrumb|Carousel|Modal|Table|Select|Tabs)(\\.)(Header|Body|Footer|Brand|Links|Actions|Item|Divider|Slide|Head|Row|Cell|Option|Page)\\b((?:\\.(?!\\p{Lu})[\\p{XID_Start}_]\\p{XID_Continue}*(?!\\p{XID_Continue})(?!\\s*\\())*)",
          "captures": {
            "1": {
              "name": "support.class.component.webfluent"
            },
            "2": {
              "name": "punctuation.accessor.dot.webfluent"
            },
            "3": {
              "name": "support.class.sub-component.webfluent"
            },
            "4": {
              "patterns": [
                {
                  "match": "(\\.)((?!\\p{Lu})[\\p{XID_Start}_]\\p{XID_Continue}*)",
                  "captures": {
                    "1": {
                      "name": "punctuation.accessor.flag.webfluent"
                    },
                    "2": {
                      "name": "support.constant.flag.webfluent"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "built-in-components": {
      "patterns": [
        {
          "match": "(?<!\\.)\\b(Container|Row|Column|Grid|Stack|Spacer|Divider|Splitter|VirtualList|Navbar|Sidebar|Breadcrumb|Link|Menu|Tabs|TabPage|Card|Table|Thead|Tbody|Trow|Tcell|List|Badge|Avatar|Tooltip|Tag|Input|Select|Option|Checkbox|Radio|Switch|Slider|DatePicker|FileUpload|Textarea|Form|Alert|Toast|Modal|Dialog|AlertDialog|Sheet|Popover|Spinner|Progress|Skeleton|Button|IconButton|ButtonGroup|Dropdown|Image|Video|Audio|Frame|Icon|Carousel|Text|Heading|Code|Blockquote|Markdown|Callout|Kbd|EmptyState|Stat|CodeBlock|Chip|VisuallyHidden|CopyButton|ThemeToggle|LocaleSwitch|Accordion|Field|Fieldset|InputGroup|OnThisPage|Toggle|ToggleGroup|RadioGroup|Pagination|Stepper|NumberInput|Calendar|Host|Element|Portal|Unsafe|Document|Section|Paragraph|PageBreak|Header|Footer|Background|Watermark|TableOfContents|Chart|QrCode|Presentation|Slide|TitleSlide|SectionSlide|TwoColumn|ImageSlide|Router|Route)\\b((?:\\.(?!\\p{Lu})[\\p{XID_Start}_]\\p{XID_Continue}*(?!\\p{XID_Continue})(?!\\s*\\())*)",
          "captures": {
            "1": {
              "name": "support.class.component.webfluent"
            },
            "2": {
              "patterns": [
                {
                  "match": "(\\.)((?!\\p{Lu})[\\p{XID_Start}_]\\p{XID_Continue}*)",
                  "captures": {
                    "1": {
                      "name": "punctuation.accessor.flag.webfluent"
                    },
                    "2": {
                      "name": "support.constant.flag.webfluent"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "comment": "Flags after a call's `)`, each one after the last: Button(\"Save\").primary.lg",
          "match": "(?<=\\))((?:\\.(?!\\p{Lu})[\\p{XID_Start}_]\\p{XID_Continue}*(?!\\p{XID_Continue})(?!\\s*\\())+)",
          "captures": {
            "1": {
              "patterns": [
                {
                  "match": "(\\.)((?!\\p{Lu})[\\p{XID_Start}_]\\p{XID_Continue}*)",
                  "captures": {
                    "1": {
                      "name": "punctuation.accessor.flag.webfluent"
                    },
                    "2": {
                      "name": "support.constant.flag.webfluent"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "comment": "After a name or `]`, a `.name` is a member: e.message, Cart.total, items[0].title",
          "match": "(?<=[\\p{XID_Continue}\\]])(\\.)((?!\\p{Lu})[\\p{XID_Start}_]\\p{XID_Continue}*)(?!\\p{XID_Continue})(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.webfluent"
            },
            "2": {
              "name": "variable.other.property.webfluent"
            }
          }
        },
        {
          "match": "(?<=\\?\\.)((?!\\p{Lu})[\\p{XID_Start}_]\\p{XID_Continue}*)(?!\\p{XID_Continue})(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "variable.other.property.webfluent"
            }
          }
        },
        {
          "match": "(?<=[:(,{\\s])(\\.)((?!\\p{Lu})[\\p{XID_Start}_]\\p{XID_Continue}*)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.case.webfluent"
            },
            "2": {
              "name": "constant.other.enum-case.webfluent"
            }
          }
        },
        {
          "name": "variable.other.constant.design-token.webfluent",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_-]*"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "(?<!\\.)\\b(t|setLocale|navigate|replayAnimation|log)\\s*(\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.webfluent"
            },
            "2": {
              "name": "punctuation.definition.arguments.begin.webfluent"
            }
          }
        },
        {
          "match": "\\b([\\p{XID_Start}_]\\p{XID_Continue}*)\\s*(\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.webfluent"
            },
            "2": {
              "name": "punctuation.definition.arguments.begin.webfluent"
            }
          }
        }
      ]
    },
    "named-args": {
      "patterns": [
        {
          "match": "\\b([\\p{XID_Start}_][\\p{XID_Continue}-]*)\\s*(:)(?!:)",
          "captures": {
            "1": {
              "name": "variable.parameter.named.webfluent"
            },
            "2": {
              "name": "punctuation.separator.key-value.webfluent"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.spread.webfluent",
          "match": "\\.\\.\\.(?=[\\p{XID_Start}_\\[({])"
        },
        {
          "name": "keyword.operator.range.webfluent",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.null-coalescing.webfluent",
          "match": "\\?\\?"
        },
        {
          "name": "punctuation.accessor.optional.webfluent",
          "match": "\\?\\.(?=[\\p{XID_Start}_\\[(])"
        },
        {
          "name": "keyword.operator.comparison.webfluent",
